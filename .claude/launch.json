{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chemreact-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import os,http.server,socketserver;p=int(os.environ.get('PORT','8090'));socketserver.TCPServer.allow_reuse_address=True;httpd=socketserver.TCPServer(('0.0.0.0',p),http.server.SimpleHTTPRequestHandler);print(f'serving on http://localhost:{p}');httpd.serve_forever()"],
      "port": 8090,
      "autoPort": true
    },
    {
      "name": "chemreact-https",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import os,http.server,ssl;p=int(os.environ.get('PORT','8443'));s=http.server.HTTPServer(('0.0.0.0',p),http.server.SimpleHTTPRequestHandler);ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER);ctx.load_cert_chain('cert.pem');s.socket=ctx.wrap_socket(s.socket,server_side=True);print(f'serving on https://localhost:{p}');s.serve_forever()"],
      "port": 8443,
      "autoPort": true
    }
  ]
}
